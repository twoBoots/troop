[alias]
    # JungleJim Worktree Management
    # agent-start <name>: fetches origin (if available) and spawns an isolated worktree in .worktrees/<name> on branch feature/<name>
    agent-start = "!f() { git fetch origin main 2>/dev/null || true; BASE=$({ git rev-parse --verify origin/main 2>/dev/null || git rev-parse --verify main; }); git worktree add .worktrees/$1 -b feature/$1 $BASE; }; f"

    # agent-stop <name>: removes the worktree in .worktrees/<name> and deletes the local feature/<name> branch
    agent-stop = "!f() { git worktree remove .worktrees/$1 && git branch -d feature/$1; }; f"

    # List active Jims in the jungle
    jims = worktree list
